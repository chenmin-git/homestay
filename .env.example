APP_NAME=homestay-server
SERVER_PORT=8082

DB_URL=jdbc:mysql://localhost:3306/homestay?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRE_HOURS=72

# Optional Vite dev proxy target when the backend is not running on 8082.
VITE_API_TARGET=http://localhost:8082
